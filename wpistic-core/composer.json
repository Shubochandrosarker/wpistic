{
    "name": "wpistic/wpistic-core",
    "description": "Dev tooling (tests) for the WPistic Core plugin. Not required at runtime.",
    "license": "GPL-2.0-or-later",
    "type": "wordpress-plugin",
    "require": {
        "php": ">=8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "brain/monkey": "^2.6"
    },
    "autoload": {
        "psr-4": {
            "WPistic\\Core\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WPistic\\Core\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": false
        },
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit"
    }
}
