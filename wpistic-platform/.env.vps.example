# WPistic control plane — self-hosted configuration.
# Copy to .env.vps and fill in. Never commit the filled copy.
#
# Generate the secrets marked GENERATE with:
#   npm run vps:secrets
# See docs/VPS_DEPLOYMENT.md for the full walkthrough.

# --- Database --------------------------------------------------------------
POSTGRES_USER=wpistic
POSTGRES_PASSWORD=            # GENERATE — a long random string
POSTGRES_DB=wpistic
# Host is the compose service name; the database is never exposed to the host.
DATABASE_URL=postgresql://wpistic:CHANGE_ME@postgres:5432/wpistic
DATABASE_POOL_MAX=10

# --- Public URLs -----------------------------------------------------------
# These are what customers and plugins see, so they must be the hostnames your
# Cloudflare Tunnel serves — not the internal container addresses. Getting one
# wrong sends customers to a domain that does not exist.
PUBLIC_API_URL=https://api.example.com
PUBLIC_ACCOUNT_URL=https://account.example.com
PUBLIC_DASHBOARD_URL=https://app.example.com
PUBLIC_ADMIN_URL=https://admin.example.com

# Must equal PUBLIC_ACCOUNT_URL: the API verifies the `iss` claim on every
# access token against it, so a mismatch rejects every login.
ACCOUNT_SERVICE_URL=https://account.example.com
DASHBOARD_URL=https://app.example.com

# --- Identity service ------------------------------------------------------
ISSUER=https://account.example.com
COOKIE_DOMAIN=example.com     # parent domain, so the session cookie is shared
DEFAULT_REDIRECT=https://app.example.com

# --- Secrets ---------------------------------------------------------------
# RS256 keypair for access tokens. PEM, with literal \n between lines.
JWT_PRIVATE_KEY=              # GENERATE
JWT_PUBLIC_KEY=               # GENERATE
# A separate RS256 keypair for plugin activation tokens — a distinct audience,
# so a leaked license key can never be used as a dashboard credential.
LICENSE_JWT_PRIVATE_KEY=      # GENERATE
LICENSE_JWT_PUBLIC_KEY=       # GENERATE
# HMAC master key for the signatures plugins verify offline.
LICENSE_SIGNING_SECRET=       # GENERATE — 32 random bytes, hex
# AES key encrypting TOTP secrets at rest. Rotating it invalidates every
# enrolled authenticator, including yours.
MFA_ENC_KEY=                  # GENERATE — 32 random bytes, base64

# --- Staff access ----------------------------------------------------------
# Empty means nobody can reach the admin portal. Set this before you deploy or
# you will be locked out of your own panel.
ADMIN_EMAILS=you@example.com
# support_agent < billing_admin < platform_admin < super_admin.
ADMIN_ROLES=you@example.com=super_admin
# Leave false. The legacy token bypasses per-person attribution and is for
# local release automation only.
ALLOW_LEGACY_ADMIN_TOKEN=false

# --- Storage ---------------------------------------------------------------
BLOB_DRIVER=disk              # disk | s3
BLOB_ROOT=/var/lib/wpistic/blobs
# Only when BLOB_DRIVER=s3:
# S3_ENDPOINT=https://s3.example.com
# S3_BUCKET=wpistic-updates
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true

# --- Billing ---------------------------------------------------------------
# FREE_ONLY | STRIPE_TEST | STRIPE_LIVE. Leave FREE_ONLY until an authorized
# payment administrator supplies real credentials.
BILLING_MODE=FREE_ONLY
STRIPE_PUBLISHABLE_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# --- Email -----------------------------------------------------------------
# Without this, password resets and invitations are written to the database
# and never delivered. Customers cannot recover their own accounts until it is
# set. Point it at a relay that accepts { to, template, data }.
EMAIL_WEBHOOK_URL=

# --- Scheduler -------------------------------------------------------------
SCHEDULER_INTERVAL_MS=60000
