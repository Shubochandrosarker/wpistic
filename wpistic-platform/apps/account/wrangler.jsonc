{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "compatibility_date": "2026-08-06",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "src/index.ts",
  "env": {
    "staging": {
      "name": "wpistic-account-staging",
      "routes": [
        {
          "pattern": "account-staging.wpistic.com",
          "custom_domain": true
        }
      ],
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE"
        }
      ],
      "kv_namespaces": [
        {
          "binding": "PKCE_STORAGE"
        }
      ],
      "vars": {
        "ENVIRONMENT": "staging",
        "ISSUER": "https://account-staging.wpistic.com",
        "COOKIE_DOMAIN": "account-staging.wpistic.com",
        "DEFAULT_REDIRECT": "https://app-staging.wpistic.com"
      },
      "secrets": {
        "required": [
          "JWT_PRIVATE_KEY",
          "JWT_PUBLIC_KEY",
          "MFA_ENC_KEY",
          "EMAIL_WEBHOOK_URL"
        ]
      },
      "observability": {
        "enabled": true,
        "head_sampling_rate": 1
      },
      "workers_dev": false
    },
    "production": {
      "name": "wpistic-account",
      "routes": [
        {
          "pattern": "account.wpistic.com",
          "custom_domain": true
        }
      ],
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE"
        }
      ],
      "kv_namespaces": [
        {
          "binding": "PKCE_STORAGE"
        }
      ],
      "vars": {
        "ENVIRONMENT": "production",
        "ISSUER": "https://account.wpistic.com",
        "COOKIE_DOMAIN": "account.wpistic.com",
        "DEFAULT_REDIRECT": "https://app.wpistic.com"
      },
      "secrets": {
        "required": [
          "JWT_PRIVATE_KEY",
          "JWT_PUBLIC_KEY",
          "MFA_ENC_KEY",
          "EMAIL_WEBHOOK_URL"
        ]
      },
      "observability": {
        "enabled": true,
        "head_sampling_rate": 0.25
      },
      "workers_dev": false
    }
  }
}
