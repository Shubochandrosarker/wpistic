{
  "name": "@wpistic/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "api.wpistic.com — WPistic control plane API (modular monolith on Cloudflare Workers)",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "deploy": "wrangler deploy",
    "build": "wrangler deploy --dry-run --outdir dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:coverage": "vitest --coverage"
  },
  "dependencies": {
    "@wpistic/types": "*",
    "@hono/zod-validator": "^0.4.1",
    "hono": "^4.6.3",
    "jose": "^5.9.3",
    "postgres": "^3.4.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240925.0",
    "@vitest/ui": "^1.6.0",
    "typescript": "^5.5.4",
    "vitest": "^1.6.0",
    "wrangler": "^3.80.0"
  }
}
