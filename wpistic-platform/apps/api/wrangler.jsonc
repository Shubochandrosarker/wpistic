{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "compatibility_date": "2026-08-06",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "src/index.ts",
  "env": {
    "staging": {
      "name": "wpistic-api-staging",
      "routes": [
        {
          "pattern": "api-staging.wpistic.com",
          "custom_domain": true
        }
      ],
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE"
        }
      ],
      "kv_namespaces": [
        {
          "binding": "RATE_LIMIT"
        },
        {
          "binding": "SESSION_CACHE"
        }
      ],
      "queues": {
        "producers": [
          {
            "binding": "EVENT_BUS",
            "queue": "wpistic-staging-events"
          }
        ],
        "consumers": [
          {
            "queue": "wpistic-staging-events",
            "max_batch_size": 25,
            "max_batch_timeout": 30,
            "max_retries": 5,
            "dead_letter_queue": "wpistic-staging-events-dlq"
          }
        ]
      },
      "r2_buckets": [
        {
          "binding": "UPDATE_PACKAGES",
          "bucket_name": "wpistic-staging-updates"
        },
        {
          "binding": "ASSETS",
          "bucket_name": "wpistic-staging-assets"
        }
      ],
      "triggers": {
        "crons": [
          "* * * * *"
        ]
      },
      "vars": {
        "ENVIRONMENT": "staging",
        "ACCOUNT_SERVICE_URL": "https://account-staging.wpistic.com",
        "DASHBOARD_URL": "https://app-staging.wpistic.com",
        "PUBLIC_API_URL": "https://api-staging.wpistic.com",
        "PUBLIC_ACCOUNT_URL": "https://account-staging.wpistic.com",
        "PUBLIC_DASHBOARD_URL": "https://app-staging.wpistic.com",
        "PUBLIC_ADMIN_URL": "https://admin-staging.wpistic.com",
        "BILLING_MODE": "FREE_ONLY",
        "STRIPE_PUBLISHABLE_KEY": "",
        "ADMIN_EMAILS": "",
        "ADMIN_ROLES": ""
      },
      "secrets": {
        "required": [
          "LICENSE_SIGNING_SECRET",
          "LICENSE_JWT_PRIVATE_KEY",
          "LICENSE_JWT_PUBLIC_KEY",
          "JWT_PRIVATE_KEY",
          "JWT_PUBLIC_KEY",
          "MFA_ENC_KEY"
        ]
      },
      "observability": {
        "enabled": true,
        "head_sampling_rate": 1
      },
      "workers_dev": false
    },
    "production": {
      "name": "wpistic-api",
      "routes": [
        {
          "pattern": "api.wpistic.com",
          "custom_domain": true
        }
      ],
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE"
        }
      ],
      "kv_namespaces": [
        {
          "binding": "RATE_LIMIT"
        },
        {
          "binding": "SESSION_CACHE"
        }
      ],
      "queues": {
        "producers": [
          {
            "binding": "EVENT_BUS",
            "queue": "wpistic-events"
          }
        ],
        "consumers": [
          {
            "queue": "wpistic-events",
            "max_batch_size": 25,
            "max_batch_timeout": 30,
            "max_retries": 5,
            "dead_letter_queue": "wpistic-events-dlq"
          }
        ]
      },
      "r2_buckets": [
        {
          "binding": "UPDATE_PACKAGES",
          "bucket_name": "wpistic-updates"
        },
        {
          "binding": "ASSETS",
          "bucket_name": "wpistic-assets"
        }
      ],
      "triggers": {
        "crons": [
          "* * * * *"
        ]
      },
      "vars": {
        "ENVIRONMENT": "production",
        "ACCOUNT_SERVICE_URL": "https://account.wpistic.com",
        "DASHBOARD_URL": "https://app.wpistic.com",
        "PUBLIC_API_URL": "https://api.wpistic.com",
        "PUBLIC_ACCOUNT_URL": "https://account.wpistic.com",
        "PUBLIC_DASHBOARD_URL": "https://app.wpistic.com",
        "PUBLIC_ADMIN_URL": "https://admin.wpistic.com",
        "BILLING_MODE": "FREE_ONLY",
        "STRIPE_PUBLISHABLE_KEY": "",
        "ADMIN_EMAILS": "",
        "ADMIN_ROLES": ""
      },
      "secrets": {
        "required": [
          "LICENSE_SIGNING_SECRET",
          "LICENSE_JWT_PRIVATE_KEY",
          "LICENSE_JWT_PUBLIC_KEY",
          "JWT_PRIVATE_KEY",
          "JWT_PUBLIC_KEY",
          "MFA_ENC_KEY"
        ]
      },
      "observability": {
        "enabled": true,
        "head_sampling_rate": 0.25
      },
      "workers_dev": false
    }
  }
}
