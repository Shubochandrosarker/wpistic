---
interface Props {
  label: string;
  value: string | number;
  hint?: string;
}
const { label, value, hint } = Astro.props;
---

<div class="bg-surface border border-border rounded-card shadow-card p-5">
  <p class="text-[13px] text-muted">{label}</p>
  <p class="text-2xl font-semibold mt-1 tracking-tight">{value}</p>
  {hint && <p class="text-[12px] text-muted mt-1">{hint}</p>}
</div>
