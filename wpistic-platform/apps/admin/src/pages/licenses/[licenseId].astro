---
import AdminLayout from '../../layouts/AdminLayout.astro';
import LicenseManager, { type LicenseDetail } from '../../components/LicenseManager.tsx';
import { adminContext, adminGet, shortDate } from '../../lib/api';

const { licenseId } = Astro.params;

interface DetailResponse {
  license: LicenseDetail & { grace_period_ends_at: string | null; created_at: string };
  activations: Array<{
    id: string;
    domain_normalized: string;
    environment: string;
    status: string;
    product_version: string | null;
    last_seen_at: string | null;
  }>;
  events: Array<{ event_type: string; actor_type: string; domain: string | null; created_at: string }>;
  plans: Array<{ slug: string }>;
}

let data: DetailResponse | null = null;
let loadError: string | null = null;
try {
  data = await adminGet<DetailResponse>(adminContext(Astro), `/licenses/${licenseId}`);
} catch (err) {
  loadError = err instanceof Error ? err.message : 'Could not load this license';
}
---

<AdminLayout title={data ? data.license.key_mask : 'License'} active="licenses">
  <div class="mb-6">
    <a href="/licenses" class="text-xs text-muted hover:text-white">← Licenses</a>
    <h1 class="text-xl font-semibold tracking-tight mt-1 font-mono">
      {data ? data.license.key_mask : 'License'}
    </h1>
    {
      data && (
        <p class="text-sm text-muted mt-1">
          {data.license.product} · {data.license.status} ·{' '}
          <a href={`/organizations/${data.license.organization_id}`} class="hover:text-white">
            {data.license.organization}
          </a>
        </p>
      )
    }
  </div>

  {loadError && <p class="text-sm text-red-300">{loadError}</p>}

  {
    data && (
      <>
        <LicenseManager
          client:load
          license={data.license}
          planOptions={data.plans.map((p) => p.slug)}
        />

        <section class="bg-surface border border-border rounded-xl shadow-card mb-6">
          <header class="px-4 py-3 border-b border-border">
            <h2 class="text-sm font-semibold">Activations</h2>
          </header>
          <div class="p-4">
            {data.activations.length === 0 ? (
              <p class="text-[13px] text-muted">No sites activated.</p>
            ) : (
              <ul class="space-y-1">
                {data.activations.map((activation) => (
                  <li class="flex items-center justify-between text-[13px] py-1">
                    <span class="font-mono text-[12px] text-[#A1A1A1]">
                      {activation.domain_normalized}
                      <span class="text-muted ml-2">{activation.environment}</span>
                    </span>
                    <span class="text-muted">
                      {activation.status} · {activation.product_version ?? '—'} ·{' '}
                      {activation.last_seen_at ? shortDate(activation.last_seen_at) : 'never seen'}
                    </span>
                  </li>
                ))}
              </ul>
            )}
          </div>
        </section>

        <section class="bg-surface border border-border rounded-xl shadow-card mb-6">
          <header class="px-4 py-3 border-b border-border">
            <h2 class="text-sm font-semibold">History</h2>
            <p class="text-[12px] text-muted mt-0.5">Most recent 50 events on this license.</p>
          </header>
          <div class="p-4">
            <ul class="space-y-1">
              {data.events.map((event, index) => (
                <li class="flex items-center justify-between text-[13px] py-1" data-index={index}>
                  <span class="text-[#A1A1A1]">
                    {event.event_type.replace(/_/g, ' ')}
                    {event.domain && <span class="font-mono text-[12px] text-muted ml-2">{event.domain}</span>}
                  </span>
                  <span class="text-muted">
                    {event.actor_type} · {shortDate(event.created_at)}
                  </span>
                </li>
              ))}
            </ul>
          </div>
        </section>
      </>
    )
  }
</AdminLayout>
