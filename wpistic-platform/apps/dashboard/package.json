{
  "name": "@wpistic/dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "app.wpistic.com — customer ecosystem dashboard (React SPA on Workers Assets)",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "vite build && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "build:staging": "VITE_API_URL=https://api-staging.wpistic.com VITE_ACCOUNT_URL=https://account-staging.wpistic.com vite build",
    "build:production": "VITE_API_URL=https://api.wpistic.com VITE_ACCOUNT_URL=https://account.wpistic.com vite build",
    "deploy:staging": "npm run build:staging && wrangler deploy --env staging",
    "deploy:production": "npm run build:production && wrangler deploy --env production",
    "dry-run:staging": "npm run build:staging && wrangler deploy --env staging --dry-run",
    "dry-run:production": "npm run build:production && wrangler deploy --env production --dry-run"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.56.2",
    "@wpistic/auth-sdk": "*",
    "@wpistic/platform-sdk": "*",
    "@wpistic/types": "*",
    "lucide-react": "^0.441.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "recharts": "^2.12.7",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.8",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@wpistic/ui-design-system": "*",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.5.4",
    "vite": "^5.4.8",
    "wrangler": "4.114.0"
  }
}
