{
    "name": "wpistic/wordpress-sdk",
    "description": "WPistic Plugin SDK — shared licensing, activation, entitlements, and secure updates for WPistic WordPress plugins",
    "type": "library",
    "license": "GPL-2.0-or-later",
    "keywords": ["wordpress", "licensing", "updates", "wpistic"],
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6 || ^10.5",
        "squizlabs/php_codesniffer": "^3.9",
        "wp-coding-standards/wpcs": "^3.1",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "WPistic\\Sdk\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WPistic\\Sdk\\Tests\\": "tests/phpunit/"
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "lint": "phpcs"
    }
}
