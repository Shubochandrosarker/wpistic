{
  "name": "wpistic-platform",
  "version": "0.1.0",
  "private": true,
  "description": "WPistic ecosystem control plane \u2014 federated edge-native SaaS platform on Cloudflare Workers",
  "workspaces": [
    "apps/*",
    "packages/*",
    "database"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "db:migrate": "npm --workspace @wpistic/database run migrate",
    "db:seed": "npm --workspace @wpistic/database run seed",
    "db:status": "npm --workspace @wpistic/database run status",
    "deploy:account": "npm --workspace @wpistic/account run deploy",
    "deploy:admin": "npm --workspace @wpistic/admin run deploy",
    "deploy:api": "npm --workspace @wpistic/api run deploy",
    "deploy:dashboard": "npm --workspace @wpistic/dashboard run deploy",
    "dev:account": "npm --workspace @wpistic/account run dev",
    "dev:admin": "npm --workspace @wpistic/admin run dev",
    "dev:api": "npm --workspace @wpistic/api run dev",
    "dev:dashboard": "npm --workspace @wpistic/dashboard run dev",
    "staging:down": "docker compose --env-file .env.staging -f docker-compose.staging.yml down",
    "staging:env": "node docker/generate-staging-env.mjs",
    "staging:logs": "docker compose --env-file .env.staging -f docker-compose.staging.yml logs -f",
    "staging:ps": "docker compose --env-file .env.staging -f docker-compose.staging.yml ps",
    "staging:reset": "docker compose --env-file .env.staging -f docker-compose.staging.yml down -v",
    "staging:smoke": "node tests/e2e/staging-smoke.mjs",
    "staging:up": "docker compose --env-file .env.staging -f docker-compose.staging.yml up -d --build",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "vps:backup": "bash docker/backup-vps.sh",
    "vps:down": "docker compose --env-file .env.vps -f docker-compose.vps.yml down",
    "vps:logs": "docker compose --env-file .env.vps -f docker-compose.vps.yml logs -f",
    "vps:ps": "docker compose --env-file .env.vps -f docker-compose.vps.yml ps",
    "vps:secrets": "node docker/generate-vps-secrets.mjs",
    "vps:up": "docker compose --env-file .env.vps -f docker-compose.vps.yml up -d --build"
  },
  "devDependencies": {
    "esbuild": "^0.24.2",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=20"
  }
}
