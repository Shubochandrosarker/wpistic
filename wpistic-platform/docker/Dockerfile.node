# Self-hosted image for the WPistic control plane.
#
# One image, six roles, chosen by the command: `api`, `account`, `dashboard`,
# `admin`, `scheduler`, `migrate`. Keeping them in one image means one build
# and one thing to keep patched.
#
# Two stages. The builder installs the full workspace and bundles each entry
# point into a single .mjs with esbuild; the runtime carries only those bundles.
# Nothing from node_modules ships, so there is no dependency tree to audit on
# the server and no npm install at deploy time.

# ---------------------------------------------------------------------------
FROM node:22-alpine AS builder
WORKDIR /build

# Manifests first: this layer only rebuilds when dependencies actually change,
# so ordinary source edits reuse the cached install.
COPY package.json package-lock.json ./
COPY apps/api/package.json           apps/api/
COPY apps/account/package.json       apps/account/
COPY apps/admin/package.json         apps/admin/
COPY apps/dashboard/package.json     apps/dashboard/
COPY packages/types/package.json     packages/types/
COPY packages/auth-sdk/package.json  packages/auth-sdk/
COPY packages/platform-sdk/package.json packages/platform-sdk/
COPY packages/ui-design-system/package.json packages/ui-design-system/
COPY packages/node-runtime/package.json packages/node-runtime/
COPY database/package.json           database/
RUN npm ci --no-audit --no-fund

COPY . .

RUN npm --workspace @wpistic/api     run build:node \
 && npm --workspace @wpistic/api     run build:scheduler \
 && npm --workspace @wpistic/account run build:node

# The customer dashboard is a static SPA. Built here and copied into the
# runtime image so the same container can serve it, avoiding a separate
# web server for a directory of files.
RUN npm --workspace @wpistic/dashboard run build

# The admin portal, built for plain Node instead of the Cloudflare adapter.
# Its SSR output bundles everything except `astro`, `react`, and `react-dom`,
# so a minimal runtime install (pinned to the workspace lockfile versions)
# is prepared here and copied next to the dist in the runtime stage.
RUN ASTRO_ADAPTER=node npm --workspace @wpistic/admin run build
RUN mkdir /admin-runtime && cd /admin-runtime \
 && node -e "const l=require('/build/package-lock.json');const v=p=>l.packages['node_modules/'+p].version;require('fs').writeFileSync('package.json',JSON.stringify({name:'wpistic-admin-runtime',private:true,dependencies:{astro:v('astro'),react:v('react'),'react-dom':v('react-dom')}}))" \
 && npm install --omit=dev --no-audit --no-fund

# ---------------------------------------------------------------------------
FROM node:22-alpine AS runtime
WORKDIR /app

# curl for container healthchecks; tini so signals reach Node directly and the
# graceful-shutdown path (drain waitUntil work, close the pool) actually runs.
RUN apk add --no-cache curl tini

COPY --from=builder /build/apps/api/dist-node/server.mjs        ./api/server.mjs
COPY --from=builder /build/apps/api/dist-node/scheduler.mjs     ./api/scheduler.mjs
COPY --from=builder /build/apps/account/dist-node/server.mjs    ./account/server.mjs
COPY --from=builder /build/apps/dashboard/dist                  ./dashboard
COPY --from=builder /build/apps/admin/dist                      ./admin
COPY --from=builder /admin-runtime/node_modules                 ./admin/node_modules
COPY docker/static-server.mjs                                   ./dashboard-server.mjs
COPY --from=builder /build/database                             ./database
COPY --from=builder /build/node_modules/postgres                ./node_modules/postgres
COPY docker/entrypoint.node.sh                                  ./entrypoint.sh
RUN chmod +x ./entrypoint.sh

# Package bytes live here. Declared so a `docker run` without an explicit mount
# still works; docker-compose.vps.yml binds a named volume over it.
RUN mkdir -p /var/lib/wpistic/blobs && chown -R node:node /var/lib/wpistic

# Unprivileged by default. Nothing here needs root, and a compromised update
# handler should not be able to write outside its own volume.
USER node

ENTRYPOINT ["/sbin/tini", "--", "./entrypoint.sh"]
CMD ["api"]
